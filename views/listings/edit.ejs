<% layout("/layouts/boilerplate") %>

<style>
/* ------------------- Main Container ------------------- */
.form-container {
  display: flex;
  gap: 20px;
  justify-content: space-between;
  background: #f4f6fa; 
  padding: 40px;
  border-radius: 20px;
  flex-direction: row; /* side by side */
}

/* ------------------- Inner Boxes ------------------- */
.form-box {
  flex: 1;
  background: #001233; /* dark navy blue */
  color: #ffffff;
  padding: 30px;
  border-radius: 16px;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.form-box h2 {
  margin-bottom: 20px;
  font-size: 1.4rem;
  font-weight: 600;
  color: #00b4d8; /* highlight blue heading */
  border-bottom: 2px solid rgba(255, 255, 255, 0.2);
  padding-bottom: 8px;
}

/* ---------- Form Controls ---------- */
.form-group label {
  color: #e0eaff; /* soft light blue for readability on dark box */
  font-weight: 600;
  margin-bottom: 6px;
  display: block;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 12px 14px;
  font-size: 0.95rem;
  border-radius: 10px;
  border: none;
  outline: none;
  background-color: #ffffff; /* solid white inputs for contrast */
  color: #001233; /* dark text inside input */
  box-shadow: 0 3px 8px rgba(0, 37, 88, 0.15);
 
}

.form-group textarea {
  resize: vertical;
  min-height: 80px;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #646c7e; /* subtle gray placeholders */
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border: 2px solid #00b4d8; /* bright cyan border on focus */
  box-shadow: 0 0 8px 2px rgba(126, 200, 255, 0.3); /* light blue glow */
  
}

/* ---------Select Option ---------*/



.form-group select option {
  background-color: #001233; /* dark blue background for options */
  color: #ffffff; /* white text */
}

.form-group select:focus {
  border-color: #00b4d8; /* light blue glow */
  box-shadow: 0 0 5px rgba(0, 180, 216, 0.4);
}







/* ---------- Dropdown ---------- */
.dropdown-toggle {
  width: 100% !important;
  text-align: start !important;
  background: #ffffff;
  border: none;
  color: #001233;
  padding: 12px 14px !important; 
  border-radius: 10px;
  font-weight: 500;
  cursor: pointer;
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
  transition: background 0.2s ease, box-shadow 0.2s ease;
}

.dropdown-toggle:focus{
    border: 2px solid #00b4d8;
    box-shadow: 0 0 8px 2px rgba(126, 200, 255, 0.3);
    outline: none;
}

.dropdown-toggle:hover {
  background: #e0eaff;
  box-shadow: 0 0 8px 2px rgba(126, 200, 255, 0.3);
}

.dropdown-menu {
  display: none; /* hidden by default */
  width: 60%;
  background: #ffffff;
  border-radius: 10px;
  padding: 10px;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
}

.dropdown-menu label {
  display: flex;
  align-items: center;
  padding: 3px 10px;
  cursor: pointer;
  font-weight: 500;
  color: #023E7D;
  border-radius: 6px;
  transition: background 0.2s ease;
  margin-bottom: 0;
}

.dropdown-menu label:hover {
  background-color: #e2e7f1;
}


.dropdown-menu input[type="checkbox"] {
  width: auto;          /* keep default checkbox width */
  height: auto;         /* keep default checkbox height */
  margin-right: 8px;    /* spacing between checkbox and label */
  transform: scale(1.2); /* slightly larger but not huge */
  vertical-align: middle;
  cursor: pointer;
  box-shadow: none !important;
}


.dropdown.open .dropdown-menu {
  display: block; /* show when open */
}


/* ---------- Carousel Container ---------- */
#listingCarousel {
  position: relative;
  max-width: 700px;
  margin: 20px auto;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.15);
  background: #f9f9f9;
}

/* ---------- Carousel Images ---------- */
#listingCarousel .preview-img {
  height: 270px;       /* default height */
  object-fit: cover;   /* maintain aspect ratio */
  border-radius: 10px;
}

/* ---------- Delete Checkbox Overlay ---------- */
#listingCarousel .form-check {
  position: absolute;
  top: 10px;
  right: 10px;
  background: rgba(0, 0, 0, 0.6);
  padding: 6px 12px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

#listingCarousel .form-check input {
  margin-right: 6px;
  cursor: pointer;
}

#listingCarousel .form-check i {
  color: #fff;
  font-size: 1rem;
  transition: transform 0.3s ease, color 0.3s ease;
  cursor: pointer;
  padding: 0 15px;
}

/* Hover effect: rotate and change color */
#listingCarousel .form-check i:hover {
  transform: rotate(15deg) scale(1.2);
  color: #ff4d4d; /* red on hover */
}

/* ---------- Carousel Controls ---------- */
#listingCarousel .carousel-control-prev,
#listingCarousel .carousel-control-next {
  width: 40px;
  height: 40px;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s ease, transform 0.2s ease;
}

/* Remove default Bootstrap arrows (double circles) */
#listingCarousel .carousel-control-prev-icon,
#listingCarousel .carousel-control-next-icon {
  background-image: none;  /* removes double circle */
  width: 16px;
  height: 16px;
  border: solid #fff;      /* white arrow */
  border-width: 0 3px 3px 0;
  display: inline-block;
  padding: 3px;
}

/* Rotate arrows */
#listingCarousel .carousel-control-prev-icon {
  transform: rotate(135deg); /* left arrow */
}

#listingCarousel .carousel-control-next-icon {
  transform: rotate(-45deg); /* right arrow */
}

/* Hover effect for arrows */
#listingCarousel .carousel-control-prev:hover,
#listingCarousel .carousel-control-next:hover {
  background: rgba(0, 180, 216, 0.8); /* highlight on hover */
  transform: translateY(-50%) scale(1.1);
}

/* ---------- Carousel Indicators ---------- */
#listingCarousel .carousel-indicators {
  bottom: 10px;
}

#listingCarousel .carousel-indicators button {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background-color: #ddd;
}

#listingCarousel .carousel-indicators .active {
  background-color: #00b4d8; /* match your theme */
}

/* ---------- Responsive Images ---------- */
@media (max-width: 992px) {
  #listingCarousel .preview-img { height: 230px; }
}

@media (max-width: 768px) {
  #listingCarousel .preview-img { height: 180px; }
  #listingCarousel .carousel-control-prev,
  #listingCarousel .carousel-control-next { width: 30px; height: 30px; }
}

@media (max-width: 480px) {
  #listingCarousel .preview-img { height: 120px; }
  #listingCarousel .carousel-control-prev,
  #listingCarousel .carousel-control-next {
    width: 30px;
    height: 30px;
  }
}










/* ---------- Medium Screens  ---------- */
@media (max-width: 1199px) {
  .form-container {
    flex-direction: column; /* stack vertically */
    flex-wrap: wrap;
    padding: 30px 70px;
  }
  .form-box {
    flex: 1 1 100%;
  }
}

/* ---------- Small Screens (mobiles) ---------- */
@media (max-width: 768px) {
  .form-container {
    flex-direction: column; /* stack vertically */
    flex-wrap: wrap;
    padding: 20px;
  }
  .form-box {
    flex: 1 1 100%;
  }
}



</style>





