<% layout("/layouts/boilerplate") %>

<style>
    /* Contact Popup Container */
.contact-popup {
    position: fixed;
    top: -100%; /* start hidden above viewport */
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 400px;
    background-color: #001233; /* dark blue */
    color: #fff;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.3);
    z-index: 9999;
    transition: top 0.5s ease;
    padding: 20px;
}

/* Show popup */
.contact-popup.show {
    top: 20px; /* slide down */
}

/* Close button */
.close-btn {
    position: absolute;
    top: 10px;
    right: 15px;
    font-size: 1.5rem;
    cursor: pointer;
    color: #00b4d8; /* light blue */
}

/* Contact content text */
.contact-popup p {
    margin: 10px 0;
    font-size: 0.95rem;
}

.contact-popup h4 {
    margin-bottom: 10px;
    color: #00b4d8;
}

.booking-info {
    background-color: #f8f9fa;  /* soft light gray */
    border: 1px solid #ddd;     /* simple thin border */
    border-radius: 8px;         /* smooth corners */
    padding: 15px 20px;
    margin: 15px 0;
}

.booking-info h5 {
    margin-bottom: 10px;
    font-size: 1.1rem;
    color: #023E7D;  /* simple dark blue for heading */
    font-weight: 600;
}

.booking-info ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.booking-info li {
    margin: 6px 0;
    font-size: 0.95rem;
    line-height: 1.5;
}

.booking-info b {
    color: #333; /* simple dark text */
}

.listing-details {
    margin: 20px 0;
    font-family: Arial, sans-serif;
}

.details-section, .booking-info {
    background: #f8f9fa;       /* light gray background */
    border: 1px solid #ddd;    /* simple border */
    border-radius: 8px;
    padding: 15px 20px;
    margin-bottom: 15px;
}

.details-section h5,
.booking-info h5 {
    margin-bottom: 10px;
    font-size: 1.1rem;
    font-weight: 600;
    color: #023E7D;            /* consistent blue heading */
    border-bottom: 1px solid #ccc;
    padding-bottom: 5px;
}

.details-section p,
.booking-info li {
    margin: 6px 0;
    font-size: 0.95rem;
    line-height: 1.5;
}

.booking-info ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

/* ---------- Carousel Container ---------- */
#listingCarousel {
  position: relative;
  max-width: 700px;
  margin: 20px auto;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.15);
  background: #f9f9f9;
}


/* ---------- Carousel Images ---------- */
#listingCarousel .preview-img {
  height: 300px;       /* default height */
  object-fit: fill;   /* maintain aspect ratio */
  border-radius: 10px;
}


/* ---------- Carousel Controls ---------- */
#listingCarousel .carousel-control-prev,
#listingCarousel .carousel-control-next {
  width: 40px;
  height: 40px;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s ease, transform 0.2s ease;
}

/* Remove default Bootstrap arrows (double circles) */
#listingCarousel .carousel-control-prev-icon,
#listingCarousel .carousel-control-next-icon {
  background-image: none;  /* removes double circle */
  width: 16px;
  height: 16px;
  border: solid #fff;      /* white arrow */
  border-width: 0 3px 3px 0;
  display: inline-block;
  padding: 3px;
}

/* Rotate arrows */
#listingCarousel .carousel-control-prev-icon {
  transform: rotate(135deg); /* left arrow */
}

#listingCarousel .carousel-control-next-icon {
  transform: rotate(-45deg); /* right arrow */
}

/* Hover effect for arrows */
#listingCarousel .carousel-control-prev:hover,
#listingCarousel .carousel-control-next:hover {
  background: rgba(0, 180, 216, 0.8); /* highlight on hover */
  transform: translateY(-50%) scale(1.1);
}

/* ---------- Carousel Indicators ---------- */
#listingCarousel .carousel-indicators {
  bottom: 10px;
}

#listingCarousel .carousel-indicators button {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background-color: #ddd;
}

#listingCarousel .carousel-indicators .active {
  background-color: #00b4d8; /* match your theme */
}

/* ---------- Responsive Images ---------- */
@media (max-width: 992px) {
  #listingCarousel .preview-img { height: 250px; }
}

@media (max-width: 768px) {
  #listingCarousel .preview-img { height: 200px; }
  #listingCarousel .carousel-control-prev,
  #listingCarousel .carousel-control-next { width: 30px; height: 30px; }
}

@media (max-width: 480px) {
  #listingCarousel .preview-img { height: 120px; }
  #listingCarousel .carousel-control-prev,
  #listingCarousel .carousel-control-next {
    width: 30px;
    height: 30px;
  }
}







</style>


