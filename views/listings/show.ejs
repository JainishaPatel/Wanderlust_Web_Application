             <form method="GET" action="/listings/<%= listing._id %>/rooms">
                <button type="submit" class="action-btn"><i class="bi bi-door-open"></i>Room Details</button>
            </form>
     
        <% } %>
              
            <!-- Contact Info Button -->
                
