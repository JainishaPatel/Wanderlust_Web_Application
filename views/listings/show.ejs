                    (per night for entire property)
                <% } %>
               
                <li><b>Check-in:</b> &nbsp; <%= listing.checkin %> &nbsp; | &nbsp; <b>Check-out:</b> &nbsp; <%= listing.checkout %></li>
            </ul>
        </div>

        <!-- Address -->
        <% if(listing.address && listing.address.length > 0) { %>
            <div class="details-section">
