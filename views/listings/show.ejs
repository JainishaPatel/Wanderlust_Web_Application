        <% if (listing.propertyFacilities && listing.propertyFacilities.length > 0) { %>
            <div class="details-section">
                <h5>Facilities</h5>
                <p><%= listing.propertyFacilities.join(", ") %></p>
            </div>
        <% } %>

        <!-- Location -->
        <div class="details-section">
            <h5>Location</h5>
            <p><%= listing.location %>, <%= listing.country %></p>
        </div>
    </div>
        
    <br><hr>
        
